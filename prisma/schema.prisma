generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["remindme_app", "public"]
}

model Showroom {
  id        String     @id @db.Text
  payload   Json       @db.JsonB
  employees Employee[]
  customers Customer[]

  @@map("showrooms")
  @@schema("remindme_app")
}

model Employee {
  id           String  @id @db.Text
  showroomId   String  @map("showroom_id") @db.Text
  email        String  @unique @db.Text
  employeeCode String  @unique @map("employee_code") @db.Text
  payload      Json    @db.JsonB
  showroom     Showroom @relation(fields: [showroomId], references: [id], onDelete: Restrict)

  @@map("employees")
  @@schema("remindme_app")
}

model Customer {
  id         String     @id @db.Text
  showroomId String     @map("showroom_id") @db.Text
  email      String?    @db.Text
  payload    Json       @db.JsonB
  showroom   Showroom   @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  vehicles   Vehicle[]

  @@unique([id, showroomId])
  @@map("customers")
  @@schema("remindme_app")
}

model Vehicle {
  id                 String             @id @db.Text
  showroomId         String             @map("showroom_id") @db.Text
  customerId         String             @map("customer_id") @db.Text
  registrationNumber String             @unique @map("registration_number") @db.Text
  payload            Json               @db.JsonB
  customer           Customer           @relation(fields: [customerId, showroomId], references: [id, showroomId], onDelete: Restrict)
  services           Service[]
  insurancePolicies  InsurancePolicy[]
  documents          VehicleDocument[]
  reminders          Reminder[]
  notifications      Notification[]
  serviceRequests    ServiceRequest[]

  @@unique([id, showroomId, customerId])
  @@map("vehicles")
  @@schema("remindme_app")
}

model Service {
  id         String  @id @db.Text
  showroomId String  @map("showroom_id") @db.Text
  customerId String  @map("customer_id") @db.Text
  vehicleId  String  @map("vehicle_id") @db.Text
  payload    Json    @db.JsonB
  vehicle    Vehicle @relation(fields: [vehicleId, showroomId, customerId], references: [id, showroomId, customerId], onDelete: Restrict)

  @@map("services")
  @@schema("remindme_app")
}

model InsurancePolicy {
  id         String  @id @db.Text
  showroomId String  @map("showroom_id") @db.Text
  customerId String  @map("customer_id") @db.Text
  vehicleId  String  @map("vehicle_id") @db.Text
  payload    Json    @db.JsonB
  vehicle    Vehicle @relation(fields: [vehicleId, showroomId, customerId], references: [id, showroomId, customerId], onDelete: Restrict)

  @@map("insurance_policies")
  @@schema("remindme_app")
}

model VehicleDocument {
  id         String  @id @db.Text
  showroomId String  @map("showroom_id") @db.Text
  customerId String  @map("customer_id") @db.Text
  vehicleId  String  @map("vehicle_id") @db.Text
  payload    Json    @db.JsonB
  vehicle    Vehicle @relation(fields: [vehicleId, showroomId, customerId], references: [id, showroomId, customerId], onDelete: Restrict)

  @@map("documents")
  @@schema("remindme_app")
}

model Reminder {
  id         String  @id @db.Text
  showroomId String  @map("showroom_id") @db.Text
  customerId String  @map("customer_id") @db.Text
  vehicleId  String  @map("vehicle_id") @db.Text
  payload    Json    @db.JsonB
  vehicle    Vehicle @relation(fields: [vehicleId, showroomId, customerId], references: [id, showroomId, customerId], onDelete: Restrict)

  @@map("reminders")
  @@schema("remindme_app")
}

model Notification {
  id         String  @id @db.Text
  showroomId String  @map("showroom_id") @db.Text
  customerId String  @map("customer_id") @db.Text
  vehicleId  String  @map("vehicle_id") @db.Text
  payload    Json    @db.JsonB
  vehicle    Vehicle @relation(fields: [vehicleId, showroomId, customerId], references: [id, showroomId, customerId], onDelete: Restrict)

  @@map("notifications")
  @@schema("remindme_app")
}

model ServiceRequest {
  id         String  @id @db.Text
  showroomId String  @map("showroom_id") @db.Text
  customerId String  @map("customer_id") @db.Text
  vehicleId  String  @map("vehicle_id") @db.Text
  payload    Json    @db.JsonB
  vehicle    Vehicle @relation(fields: [vehicleId, showroomId, customerId], references: [id, showroomId, customerId], onDelete: Restrict)

  @@map("service_requests")
  @@schema("remindme_app")
}

model ApplicationLock {
  key        String   @id @db.Text
  ownerToken String   @map("owner_token") @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("application_locks")
  @@schema("remindme_app")
}

model DataImport {
  key         String   @id @db.Text
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)

  @@map("data_imports")
  @@schema("remindme_app")
}

// The pre-Prisma migration-era schema in public is represented for safe
// introspection and one-time account/customer import. Prisma Migrate is
// configured to treat these existing tables as externally managed.
enum LegacyUserRole {
  MANAGER
  EMPLOYEE
  CUSTOMER

  @@map("UserRole")
  @@schema("public")
}

enum LegacyUserStatus {
  ACTIVE
  INACTIVE

  @@map("UserStatus")
  @@schema("public")
}

enum LegacyEmailDeliveryStatus {
  PENDING
  PROCESSING
  ACCEPTED
  FAILED

  @@map("EmailDeliveryStatus")
  @@schema("public")
}

model LegacyUser {
  id           Int             @id @default(autoincrement()) @map("user_id")
  username     String          @unique @db.VarChar(50)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  role         LegacyUserRole
  fullName     String          @map("full_name") @db.VarChar(120)
  email        String          @unique @db.VarChar(254)
  status       LegacyUserStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @map("updated_at") @db.Timestamptz(6)
  customer     LegacyCustomer?
  handledRequests LegacyServiceRequest[]

  @@map("users")
  @@schema("public")
}

model LegacyCustomer {
  id           Int      @id @default(autoincrement()) @map("customer_id")
  userId       Int?     @unique @map("user_id")
  name         String   @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(254)
  address      String?
  registeredOn DateTime @default(now()) @map("registered_on") @db.Date
  user         LegacyUser? @relation(fields: [userId], references: [id])
  vehicles     LegacyVehicle[]
  reminders    LegacyReminder[]
  notifications LegacyNotification[]
  serviceRequests LegacyServiceRequest[]
  emailDeliveries LegacyEmailDelivery[]

  @@map("customers")
  @@schema("public")
}

model LegacyVehicle {
  id            Int       @id @default(autoincrement()) @map("vehicle_id")
  customerId    Int       @map("customer_id")
  registration  String    @unique @map("reg_number") @db.VarChar(20)
  make          String    @db.VarChar(80)
  model         String    @db.VarChar(80)
  year          Int?
  fuelType      String?   @map("fuel_type") @db.VarChar(30)
  odometer      Int?
  customer      LegacyCustomer @relation(fields: [customerId], references: [id])
  services      LegacyService[]
  policies      LegacyInsurancePolicy[]
  documents     LegacyDocument[]
  reminders     LegacyReminder[]
  serviceRequests LegacyServiceRequest[]

  @@index([customerId])
  @@map("vehicles")
  @@schema("public")
}

model LegacyService {
  id              Int       @id @default(autoincrement()) @map("service_id")
  vehicleId       Int       @map("vehicle_id")
  requestId       Int?      @unique @map("request_id")
  serviceDate     DateTime  @map("service_date") @db.Date
  serviceType     String    @map("service_type") @db.VarChar(100)
  cost            Decimal?  @db.Decimal(12, 2)
  odometerReading Int?      @map("odometer_reading")
  nextDueDate     DateTime? @map("next_due_date") @db.Date
  remarks         String?
  vehicle         LegacyVehicle @relation(fields: [vehicleId], references: [id])
  request         LegacyServiceRequest? @relation(fields: [requestId], references: [id])

  @@index([vehicleId, serviceDate])
  @@map("services")
  @@schema("public")
}

model LegacyInsurancePolicy {
  id           Int      @id @default(autoincrement()) @map("policy_id")
  vehicleId    Int      @map("vehicle_id")
  provider     String   @db.VarChar(120)
  policyNumber String   @unique @map("policy_number") @db.VarChar(100)
  startDate    DateTime @map("start_date") @db.Date
  expiryDate   DateTime @map("expiry_date") @db.Date
  premium      Decimal? @db.Decimal(12, 2)
  vehicle      LegacyVehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("insurance_policies")
  @@schema("public")
}

model LegacyDocument {
  id                Int       @id @default(autoincrement()) @map("document_id")
  vehicleId         Int       @map("vehicle_id")
  documentType      String    @map("document_type") @db.VarChar(50)
  documentNumber    String?   @map("document_number") @db.VarChar(100)
  issueDate         DateTime? @map("issue_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  filePath          String?   @map("file_path")
  verificationStatus String  @default("PENDING") @map("verification_status") @db.VarChar(30)
  uploadedAt        DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  originalFileName  String?   @map("original_file_name") @db.VarChar(255)
  mimeType          String?   @map("mime_type") @db.VarChar(100)
  fileSize          Int?     @map("file_size")
  vehicle           LegacyVehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("documents")
  @@schema("public")
}

model LegacyReminder {
  id           Int       @id @default(autoincrement()) @map("reminder_id")
  vehicleId    Int       @map("vehicle_id")
  customerId   Int       @map("customer_id")
  reminderType String    @map("reminder_type") @db.VarChar(40)
  title        String    @db.VarChar(160)
  description  String?
  dueDate      DateTime  @map("due_date") @db.Date
  status       String    @default("PENDING") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceKey    String?   @unique @map("source_key") @db.VarChar(160)
  vehicle      LegacyVehicle @relation(fields: [vehicleId], references: [id])
  customer     LegacyCustomer @relation(fields: [customerId], references: [id])
  notifications LegacyNotification[]
  emailDeliveries LegacyEmailDelivery[]

  @@index([customerId])
  @@index([vehicleId, dueDate])
  @@map("reminders")
  @@schema("public")
}

model LegacyNotification {
  id               Int       @id @default(autoincrement()) @map("notification_id")
  customerId       Int       @map("customer_id")
  reminderId       Int?      @map("reminder_id")
  notificationType String    @map("notification_type") @db.VarChar(50)
  message          String
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveryStatus   String    @map("delivery_status") @db.VarChar(30)
  channel          String    @db.VarChar(30)
  isRead           Boolean   @default(false) @map("is_read")
  customer         LegacyCustomer @relation(fields: [customerId], references: [id])
  reminder         LegacyReminder? @relation(fields: [reminderId], references: [id])

  @@unique([reminderId, notificationType, channel])
  @@index([customerId, sentAt])
  @@index([reminderId])
  @@map("notifications")
  @@schema("public")
}

model LegacyServiceRequest {
  id           Int       @id @default(autoincrement()) @map("request_id")
  customerId   Int       @map("customer_id")
  vehicleId    Int       @map("vehicle_id")
  handledById  Int?      @map("handled_by_id")
  serviceType  String    @map("service_type") @db.VarChar(100)
  description  String?
  requestDate  DateTime  @default(now()) @map("request_date") @db.Timestamptz(6)
  preferredDate DateTime? @map("preferred_date") @db.Date
  status       String    @default("PENDING") @db.VarChar(30)
  customer     LegacyCustomer @relation(fields: [customerId], references: [id])
  vehicle      LegacyVehicle @relation(fields: [vehicleId], references: [id])
  handledBy    LegacyUser? @relation(fields: [handledById], references: [id])
  service      LegacyService?

  @@index([customerId])
  @@index([vehicleId])
  @@map("service_requests")
  @@schema("public")
}

model LegacyEmailDelivery {
  id              Int                      @id @default(autoincrement()) @map("email_delivery_id")
  reminderId      Int                      @map("reminder_id")
  customerId      Int                      @map("customer_id")
  idempotencyKey  String                   @unique @map("idempotency_key") @db.VarChar(220)
  recipientEmail  String                   @map("recipient_email") @db.VarChar(254)
  emailType       String                   @map("email_type") @db.VarChar(40)
  subject         String                   @db.VarChar(255)
  textBody        String                   @map("text_body")
  htmlBody        String                   @map("html_body")
  status          LegacyEmailDeliveryStatus @default(PENDING)
  attemptCount    Int                      @default(0) @map("attempt_count")
  lastAttemptAt   DateTime?                @map("last_attempt_at") @db.Timestamptz(6)
  acceptedAt      DateTime?                @map("accepted_at") @db.Timestamptz(6)
  lastError       String?                  @map("last_error") @db.VarChar(500)
  messageId       String?                  @map("message_id") @db.VarChar(255)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @map("updated_at") @db.Timestamptz(6)
  reminder        LegacyReminder           @relation(fields: [reminderId], references: [id])
  customer        LegacyCustomer           @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([reminderId])
  @@index([status, createdAt])
  @@map("email_deliveries")
  @@schema("public")
}

model LegacySqlMigration {
  version  String   @id @db.Text
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
  @@schema("public")
}
