# Required PostgreSQL connection string. Set only in a local .env or secret store.
DATABASE_URL=

# Required in production. Use a random value of at least 32 bytes.
SESSION_SECRET=

# Optional first-admin seed. Set both to create an account only when no employees exist.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

PORT=3000
