# Prisma PostgreSQL connection. The application uses the remindme_app schema.
DATABASE_URL=
# Optional direct PostgreSQL URL for Prisma migrations/admin. For Prisma Postgres,
# leave blank to derive db.prisma.io from the pooled DATABASE_URL.
DIRECT_URL=
ALLOW_IN_MEMORY_DEMO=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SESSION_SECRET=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
PORT=3000
